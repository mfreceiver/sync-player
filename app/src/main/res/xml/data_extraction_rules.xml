<?xml version="1.0" encoding="utf-8"?>
<!--
    Defense-in-depth for android:allowBackup="false": every backup domain is
    explicitly excluded for BOTH cloud-backup and device-transfer so no
    credential-bearing data (encrypted prefs, databases, files) can ever be
    extracted by any transfer path, even if backup is re-enabled accidentally.
    device_* domains cover device-protected storage (credential-protected peer
    domains accepted by the compileSdk data-extraction-rules schema).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
